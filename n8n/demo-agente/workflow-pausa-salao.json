{
  "name": "Pausar IA (transferir para humano)",
  "nodes": [
    {
      "id": "00000000-0000-4000-9000-000000000010",
      "name": "Nota 10",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        -180
      ],
      "parameters": {
        "content": "## Transferir para humano\nChamado pelo agente quando a cliente pede uma pessoa, reclama ou sai do escopo.\nGrava `pausa:{telefone}` no Redis por 12 h, salva o resumo na ficha e avisa a Gleide no WhatsApp (config.whatsapp_alerta) com o link da conversa. Mande `#ia` na conversa para devolver à IA.",
        "width": 1440,
        "height": 360,
        "color": 3
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000011",
      "name": "Recebe pedido do agente",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "telefone"
            },
            {
              "name": "motivo"
            },
            {
              "name": "resumo"
            },
            {
              "name": "o_que_precisa"
            }
          ]
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000012",
      "name": "Gravar pausa (12h)",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        220,
        0
      ],
      "parameters": {
        "operation": "set",
        "key": "=pausa:{{ $json.telefone }}",
        "value": "={{ 'agente: ' + ($json.motivo || 'transferido') }}",
        "expire": true,
        "ttl": 43200
      },
      "credentials": {
        "redis": {
          "id": "FMNURJ61oUMdpv2C",
          "name": "Redis local"
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000013",
      "name": "Resposta",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a-resposta",
              "name": "resposta",
              "value": "TRANSFERIDO: a Gleide recebeu o resumo no WhatsApp e vai assumir esta conversa; você (IA) fica pausada para esta cliente por 12h. Responda agora numa frase gentil que passou o assunto pra Gleide e que ela responde por aqui (ex.: \"Vou confirmar com a Gleide se pode trazer seu cachorro, ela te responde por aqui, tá?\" ou \"Vou passar sua conversa pra Gleide, ela te chama por aqui 😊\"), sem prometer prazo e sem falar em equipe.",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000062",
      "name": "CRM: com humano",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        440,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO clientes (telefone, etapa, resumo) VALUES ($1, 'humano', 'Transferido: ' || $2)\nON CONFLICT (telefone) DO UPDATE SET etapa = 'humano',\n  resumo = 'Transferido: ' || $2 || COALESCE(' | ' || clientes.resumo, ''), atualizado_em = now()",
        "options": {
          "queryReplacement": "={{ [ $('Recebe pedido do agente').item.json.telefone, $('Recebe pedido do agente').item.json.motivo || 'pediu atendimento humano' ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "M7tUBvIcepziMPbo",
          "name": "CRM Postgres"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "00000000-0000-4000-8000-000000000080",
      "name": "Supabase: pausar IA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/clientes?empresa_id=eq.{{ $env.EMPRESA_ID }}&telefone=eq.{{ (() => { const d = String($('Recebe pedido do agente').first().json.telefone || '').replace(/\\D/g, ''); return /^55\\d{2}[6-9]\\d{7}$/.test(d) ? d.slice(0, 4) + '9' + d.slice(4) : d; })() }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ia_pausada_ate: $now.plus(12, 'hours').toISO(), motivo_pausa: (/reclam/i.test($('Recebe pedido do agente').first().json.motivo || '') ? 'reclamacao' : 'pediu_humano'), resumo_ia_em: $now.toISO(),\n       resumo_ia: ['Motivo: ' + ($('Recebe pedido do agente').first().json.motivo || 'pediu atendimento'), $('Recebe pedido do agente').first().json.resumo || '', $('Recebe pedido do agente').first().json.o_que_precisa ? 'Precisa de você: ' + $('Recebe pedido do agente').first().json.o_que_precisa : ''].filter(Boolean).join('\\n') }) }}",
        "options": {}
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "id": "00000000-0000-4000-8000-000000000081",
      "name": "Supabase: número de alerta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/empresas?select=alerta:config->>whatsapp_alerta&id=eq.{{ $env.EMPRESA_ID }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "options": {}
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "id": "00000000-0000-4000-8000-000000000082",
      "name": "Avisar a Gleide (WhatsApp)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_URL }}/message/sendText/{{ $env.EVOLUTION_INSTANCE }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.alerta, text: '🔔 Cliente precisa de você\\n' + ($('Supabase: pausar IA').first().json.nome || 'Cliente') + ' · ' + String($('Supabase: pausar IA').first().json.telefone || '').replace(/^55(\\d{2})(\\d{4,5})(\\d{4})$/, '($1) $2-$3') +\n      '\\n' + ($('Recebe pedido do agente').first().json.motivo || 'pediu atendimento') + ($('Recebe pedido do agente').first().json.resumo ? '\\n\\n' + $('Recebe pedido do agente').first().json.resumo : '') +\n      ($('Recebe pedido do agente').first().json.o_que_precisa ? '\\n\\nPrecisa de você: ' + $('Recebe pedido do agente').first().json.o_que_precisa : '') +\n      '\\n\\nVer e responder: ' + ($env.APP_URL || 'https://app.oistudio.com.br') + '/conversas/' + $('Supabase: pausar IA').first().json.id }) }}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput",
      "executeOnce": true
    }
  ],
  "connections": {
    "Recebe pedido do agente": {
      "main": [
        [
          {
            "node": "Gravar pausa (12h)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gravar pausa (12h)": {
      "main": [
        [
          {
            "node": "CRM: com humano",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "CRM: com humano": {
      "main": [
        [
          {
            "node": "Supabase: pausar IA",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Supabase: pausar IA": {
      "main": [
        [
          {
            "node": "Supabase: número de alerta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Supabase: número de alerta": {
      "main": [
        [
          {
            "node": "Avisar a Gleide (WhatsApp)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Avisar a Gleide (WhatsApp)": {
      "main": [
        [
          {
            "node": "Resposta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Cuiaba",
    "saveDataSuccessExecution": "all",
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": "WLbjR5DvKLRVPVX8"
  }
}