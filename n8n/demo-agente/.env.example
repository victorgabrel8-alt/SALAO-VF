# Copie este arquivo para ".env" e preencha. O .env NUNCA deve ser versionado.

# Postgres (usado pela Evolution API)
POSTGRES_USER=evolution
POSTGRES_PASSWORD=troque-esta-senha

# Evolution API - chave global (header "apikey"). Gere uma string aleatória longa.
EVOLUTION_API_KEY=troque-esta-chave
# Nome da instância do WhatsApp na Evolution
EVOLUTION_INSTANCE=salao-demo

# n8n - chave que criptografa as credenciais salvas. Gere uma vez e NÃO mude depois.
N8N_ENCRYPTION_KEY=troque-esta-chave

# Seu número (o que vai ler o QR code), só dígitos com DDI+DDD. Ex: 5566999999999
MEU_NUMERO=

# Chave do Gemini (Google AI Studio) - NÃO fica aqui; é cadastrada como
# credencial dentro do n8n. Listada só como lembrete:
# GEMINI_API_KEY=(cadastrar no n8n)

# n8n - chave da API pública (Settings > n8n API). Usada só para criar o workflow via API.
N8N_API_KEY=

# Trava da demo: só estes números (DDI+DDD+número, separados por vírgula) recebem resposta da IA.
# Deixe vazio para responder a todos.
NUMEROS_PERMITIDOS=

# IDs das credenciais no n8n (preenchidos durante o setup; usados pelo montar-workflow.js)
N8N_REDIS_CRED_ID=
N8N_GEMINI_CRED_ID=

# Google Agenda: ID da agenda usada pelo agente (Configurações da agenda > Integrar agenda). "primary" = agenda principal.
GOOGLE_CALENDAR_ID=primary
N8N_GCAL_CRED_ID=

# CRM (Postgres) - credencial no n8n
N8N_CRM_CRED_ID=

# Assistente da Gleide (docs/PLANO-IA-ALIMENTA-CRM.md): números que falam com a assistente em vez do
# atendimento (separados por vírgula, 55+DDD+número) e a credencial Postgres do banco do 004 no n8n
ASSISTENTE_NUMEROS=
N8N_ASSISTENTE_PG_CRED_ID=
