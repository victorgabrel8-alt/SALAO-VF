    {
      "id": "38ddf026-b507-4cc0-8c9b-8362752a861f",
      "name": "Teto: montar avisos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        1440
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// um aviso para a dona e outro para a agência\nconst f = $json;\nconst dona = String(f.dona || '').trim();\nconst numeroDona = String((Array.isArray(f.assist) ? f.assist[0] : String(f.assist || '').split(',')[0]) || '').replace(/\\D/g, '');\nconst oi = dona ? 'Oi, ' + dona + '! ' : 'Oi! ';\nconst paraDona = Number(f.nivel) >= 100\n  ? oi + 'Aviso da sua assistente: as ' + f.limite_mes + ' conversas do plano deste mês acabaram. Quem já está conversando comigo hoje continua sendo atendida e os lembretes de horário continuam saindo, mas cliente nova fica sem resposta automática até o mês virar ou o plano ser aumentado. Para aumentar, fale com o suporte.'\n  : oi + 'Aviso da sua assistente: já usei ' + f.uso_mes + ' das ' + f.limite_mes + ' conversas do plano deste mês. Quando chegar ao limite, cliente nova fica sem resposta automática. Se quiser aumentar o plano, fale com o suporte.';\nconst paraAgencia = '[' + \"Motor Mega Hair\" + '] ' + f.nome + ': ' + f.uso_mes + ' de ' + f.limite_mes + ' conversas no mês (' + (Number(f.nivel) >= 100 ? 'TETO: cliente nova sem resposta' : 'passou de 80%') + ').' + (numeroDona ? '' : ' A dona NÃO foi avisada: sem número em assistente_numeros.');\nreturn { json: { instancia: f.instancia, numeroDona, paraDona, paraAgencia } };"
      }
    },
