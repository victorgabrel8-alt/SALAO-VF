              "value": "FOTOS ENVIADAS: a cliente acabou de receber o link do catálogo do studio no WhatsApp, com os serviços e fotos. NÃO repita o link nem resuma o catálogo e NÃO pergunte automaticamente de agendamento. Se a mensagem dela tiver outras perguntas, responda só essas; se não tiver, não escreva nada (resposta vazia).",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000397",
      "name": "Resposta (falhou)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        900,
        200
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a-resposta",
              "name": "resposta",
              "value": "CATÁLOGO NÃO ENVIADO (falha no envio). Diga em uma frase curta que não conseguiu mandar o catálogo agora, sem prometer mandar depois. Não ofereça horário nem elogie o trabalho para compensar: se ela perguntou preço, passe o preço em texto; se não, espere o que ela disser.",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "ecbddc3b-612a-47ea-8325-e0e4925b8890",
      "name": "Loja",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        -200
      ],
      "parameters": {
        "jsCode": "// Ficha da loja deste atendimento (motor único). Tudo o que muda de uma loja para outra sai daqui.\nconst bruto = $(\"Recebe pedido da IA\").first().json.loja_json;\nconst f = typeof bruto === 'string' ? JSON.parse(bruto || 'null') : bruto;\nif (!f || !f.empresa_id) return [];\nconst sem9 = (n) => { const d = String(n).replace(/\\D/g, ''); return /^55\\d{2}9\\d{8}$/.test(d) ? d.slice(0, 4) + d.slice(5) : d; };\nconst lista = (v) => (Array.isArray(v) ? v : String(v || '').split(',')).map((s) => String(s).trim()).filter(Boolean);\nconst dona = String(f.dona || 'responsável').trim();\n// Trava de teste: números com e sem o 9 (o principal compara como o WhatsApp manda; as rotinas, sem o 9).\n// Loja ainda não liberada pela agência (config.ia.liberada) e sem lista: ninguém recebe, só a dona.\nlet permitidos = [...new Set(lista(f.permitidos).flatMap((n) => [n.replace(/\\D/g, ''), sem9(n)]).filter(Boolean))];\nif (f.liberada !== true && !permitidos.length) permitidos = ['0'];\nif (f.liberada === true) permitidos = [];\nreturn [{ json: {\n  empresa_id: f.empresa_id, nome: f.nome || '', nicho: f.nicho || '', instancia: f.instancia || '',\n  dona, dona_maiuscula: dona.toUpperCase(), nome_maiusculo: String(f.nome || '').toUpperCase(), cidade: f.cidade || '', fuso: f.fuso || 'America/Cuiaba',\n  assist: lista(f.assist).join(','), assist_sem9: lista(f.assist).map(sem9).join(','),\n  permitidos: permitidos.join(','), catalogo_link: f.catalogo_link || '',\n} }];"
      }
    },
    {
      "id": "df62e371-d332-417e-8e45-7dde3f513077",
      "name": "Entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        -200
      ],
      "parameters": {
        "jsCode": "// devolve o pedido que chegou, sem a ficha da loja\nreturn $(\"Recebe pedido da IA\").all().map((i) => { const { loja_json, ...resto } = i.json; return { json: resto }; });"
      }
    },
