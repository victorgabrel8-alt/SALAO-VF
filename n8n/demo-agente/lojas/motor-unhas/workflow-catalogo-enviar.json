          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $('Recebe pedido da IA').first().json.jid, text: (\"Aqui está o catálogo do studio:\\n\" + $('Loja').first().json.catalogo_link + \"\"), linkPreview: true, delay: 1500 }) }}",
        "options": {
