{
  "name": "Áudios prontos - Transcrever",
  "nodes": [
    {
      "id": "00000000-0000-4000-8000-000000000107",
      "name": "Recebe áudio",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "audios-transcrever",
        "responseMode": "lastNode",
        "options": {}
      },
      "webhookId": "7a8b9c0d-1e2f-4a3b-8c4d-5e6f7a8b9c02"
    },
    {
      "id": "00000000-0000-4000-8000-000000000108",
      "name": "Transcrever (Gemini)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [ { text: 'Transcreva este áudio em português do Brasil, exatamente como foi falado, com pontuação. Responda só com a transcrição.' }, { inline_data: { mime_type: $json.body.mime || 'audio/mpeg', data: $json.body.base64 } } ] }] }) }}",
        "options": {}
      },
      "credentials": {
        "googlePalmApi": {
          "id": "LAK6FIw68X0BIcHa",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000109",
      "name": "Transcrição",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        440,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a-transcricao",
              "name": "transcricao",
              "value": "={{ ($json.candidates?.[0]?.content?.parts || []).filter(p => !p.thought).map(p => p.text || '').join(' ').trim() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Recebe áudio": {
      "main": [
        [
          {
            "node": "Transcrever (Gemini)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Transcrever (Gemini)": {
      "main": [
        [
          {
            "node": "Transcrição",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Cuiaba",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true
  }
}