            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_empresa_id: $env.EMPRESA_ID, p_telefone: (() => { const d = String($('Recebe pedido da IA').item.json.telefone || '').replace(/\\D/g, ''); return /^55\\d{2}[6-9]\\d{7}$/.test(d) ? d.slice(0, 4) + '9' + d.slice(4) : d; })(),\n           p_conteudo: '🎤 Áudio pronto ' + '[áudio pronto: ' + $('Achar áudio').item.json.tema + ']' + ': ' + $('Achar áudio').item.json.transcricao,\n           p_autor: 'ia', p_tipo: 'audio', p_wa_message_id: $('Enviar áudio').item.json.key?.id || null }) }}",
        "options": {}
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "id": "00000000-0000-4000-8000-000000000106",
      "name": "Resposta (enviado)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        0,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a-resposta",
              "name": "resposta",
              "value": "={{ $('Enviar áudio').item.json.key?.id\n  ? 'ÁUDIO ENVIADO (\"' + $('Achar áudio').item.json.tema + '\"). A cliente acabou de receber este áudio (voz de terceiro, NÃO diga que é a Gleide): «' + $('Achar áudio').item.json.transcricao + '». ' +\n    'O áudio É a resposta: NÃO escreva nada sobre ele (sem apresentar, resumir, perguntar ou convidar). ' +\n    'Se ele respondeu tudo o que ela perguntou, não escreva nada (resposta vazia). ' +\n    'Se ficaram perguntas que o áudio não responde, responda só essas, curto, sem citar o áudio.'\n  : 'ÁUDIO NÃO ENVIADO (falhou). Responda em texto, curto (até 3 frases), usando SÓ o que este áudio explica, sem dizer que é da Gleide e sem acrescentar promessa (nada de \"fica super natural\", \"imperceptível\", \"não estraga\"): ' + $('Achar áudio').item.json.transcricao }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000107",
      "name": "Resposta (sem áudio)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        0,
        0
      ],
