{
  "name": "Áudios prontos - Enviar",
  "nodes": [
    {
      "id": "00000000-0000-4000-8000-000000000094",
      "name": "Recebe pedido da IA",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "tema"
            },
            {
              "name": "telefone"
            },
            {
              "name": "jid"
            },
            {
