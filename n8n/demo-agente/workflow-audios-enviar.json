            }
          ]
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000095",
      "name": "Catálogo de áudios",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/empresas?select=config&id=eq.{{ $env.EMPRESA_ID }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "id": "00000000-0000-4000-8000-000000000096",
      "name": "Já enviados a ela",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/mensagens?select=conteudo,clientes!inner(telefone)&autor=eq.ia&tipo=eq.audio&clientes.telefone=eq.{{ (() => { const d = String($('Recebe pedido da IA').item.json.telefone || '').replace(/\\D/g, ''); return /^55\\d{2}[6-9]\\d{7}$/.test(d) ? d.slice(0, 4) + '9' + d.slice(4) : d; })() }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "id": "00000000-0000-4000-8000-000000000097",
      "name": "Achar áudio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "jsCode": "\n// O tema pedido pela IA -> o áudio do catálogo com mais palavras em comum\nconst sem = (s) => String(s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');\nconst palavras = (s) => sem(s).split(/[^a-z0-9]+/).filter((p) => p.length > 2);\nconst pedido = $('Recebe pedido da IA').first().json;\nconst catalogo = ($('Catálogo de áudios').first().json.config || {}).audios_prontos || [];\nconst alvo = palavras(pedido.tema);\nlet melhor = null, nota = 0;\nfor (const a of catalogo) {\n  const ps = palavras(a.tema + ' ' + (a.quando_usar || ''));\n  const n = alvo.filter((p) => ps.includes(p)).length / Math.max(1, alvo.length);\n  if (n > nota) { melhor = a; nota = n; }\n}\nif (!melhor || nota < 0.5) return [{ json: { ok: false, resposta: 'ÁUDIO NÃO ENVIADO: não existe áudio pronto para \"' + pedido.tema + '\". Temas disponíveis: ' + catalogo.map((a) => a.tema).join('; ') + '. Responda em texto.' } }];\n// trava: a mensagem da cliente precisa falar do assunto do áudio (a IA às vezes manda áudio \"de brinde\"\n// numa conversa de outro assunto). Palavras genéricas não contam.\nconst COMUNS = new Set('mega hair cabelo cabelos quero queria fazer faz quando perguntar pergunta voce pra para por com uma uns que qual quanto natural sobre isso esse essa tem ter'.split(' '));\nconst chave = (s) => palavras(s).filter((p) => !COMUNS.has(p));\nconst doTema = chave(melhor.tema + ' ' + (melhor.quando_usar || ''));\nif (pedido.mensagem && !chave(pedido.mensagem).some((p) => doTema.some((t) => t.startsWith(p.slice(0, 5)) || p.startsWith(t.slice(0, 5)))))\n  return [{ json: { ok: false, resposta: 'ÁUDIO NÃO ENVIADO: a cliente não perguntou sobre \"' + melhor.tema + '\" nesta mensagem. Responda em texto só o que ela perguntou, sem falar desse assunto.' } }];\nconst enviados = $('Já enviados a ela').all().map((i) => i.json.conteudo || '').join(' ');\nif (enviados.includes('[áudio pronto: ' + melhor.tema + ']')) return [{ json: { ok: false, resposta: 'ÁUDIO NÃO ENVIADO: ela JÁ recebeu o áudio \"' + melhor.tema + '\" antes. Não mande de novo; responda em texto, curto, sem repetir tudo.' } }];\nreturn [{ json: { ok: true, ...melhor } }];\n"
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000098",
      "name": "Tem áudio?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "Tem áudio?",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000099",
      "name": "Baixar do Storage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/storage/v1/object/audios/{{ encodeURIComponent($json.arquivo) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "00000000-0000-4000-8000-000000000100",
      "name": "Para base64",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "operation": "binaryToPropery",
        "options": {}
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "00000000-0000-4000-8000-000000000101",
      "name": "Gravando (blocos de 8s)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "jsCode": "const total = Math.min(45000, Math.max(5000, Math.round(($('Achar áudio').item.json.duracao_s || 10) * 1000)));\nconst n = Math.max(1, Math.round(total / 7500));\nreturn Array.from({ length: n }, () => ({ json: { jid: $('Recebe pedido da IA').item.json.jid, delay: 7500 }, pairedItem: 0 }));"
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000102",
      "name": "Gravando...",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_URL }}/chat/sendPresence/{{ $env.EVOLUTION_INSTANCE }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.jid, presence: 'recording', delay: $json.delay }) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 7500
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "00000000-0000-4000-8000-000000000103",
      "name": "Enviar áudio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
