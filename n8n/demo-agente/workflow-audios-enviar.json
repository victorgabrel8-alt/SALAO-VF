        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $('Recebe pedido da IA').item.json.jid, audio: $('Para base64').item.json.data, encoding: true, delay: 2000 }) }}",
        "options": {}
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "executeOnce": true
    },
