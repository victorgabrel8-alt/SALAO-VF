{
  "name": "CRM (anotações do agente)",
  "nodes": [
    {
      "id": "00000000-0000-4000-9000-000000000004",
      "name": "Nota 4",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -206
      ],
      "parameters": {
        "content": "## Anotações do agente (CRM)\nChamado pelo agente nos marcos da conversa: grava o interesse, a objeção ou o agendamento como pré-avaliação da cliente.",
        "width": 1200,
        "height": 146,
        "color": 7
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000068",
      "name": "Recebe pedido do agente",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "telefone"
            },
            {
              "name": "nome"
            },
            {
              "name": "interesse"
            },
            {
              "name": "resumo"
            }
          ]
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000069",
      "name": "Anotar na ficha",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        300,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO clientes (telefone, nome, etapa, interesse, resumo) VALUES ($1, NULLIF($4, ''), 'conversa', NULLIF($2, ''), NULLIF($3, ''))\nON CONFLICT (telefone) DO UPDATE SET\n  interesse = COALESCE(NULLIF($2, ''), clientes.interesse),\n  resumo = COALESCE(NULLIF($3, ''), clientes.resumo),\n  nome = COALESCE(NULLIF($4, ''), clientes.nome), atualizado_em = now()",
        "options": {
          "queryReplacement": "={{ [ $json.telefone, $json.interesse || '', $json.resumo || '', $json.nome || '' ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "zzYnr5Tvb8vIFf4H",
          "name": "CRM Postgres"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "00000000-0000-4000-8000-000000000070",
      "name": "Resposta",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        900,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a-resposta",
              "name": "resposta",
              "value": "ANOTADO na ficha da cliente. Continue a conversa normalmente (não comente isso com ela).",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000088",
      "name": "Supabase: pré-avaliação",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/n8n_salvar_pre_avaliacao",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_empresa_id: $env.EMPRESA_ID, p_telefone: (() => { const d = String($('Recebe pedido do agente').first().json.telefone || '').replace(/\\D/g, ''); return /^55\\d{2}[6-9]\\d{7}$/.test(d) ? d.slice(0, 4) + '9' + d.slice(4) : d; })(),\n       p_dados: { resumo: ($('Recebe pedido do agente').first().json.resumo || $('Recebe pedido do agente').first().json.interesse || '').trim(), tecnica_interesse: ($('Recebe pedido do agente').first().json.interesse || '').trim() } }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    }
  ],
  "connections": {
    "Recebe pedido do agente": {
      "main": [
        [
          {
            "node": "Anotar na ficha",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Anotar na ficha": {
      "main": [
        [
          {
            "node": "Supabase: pré-avaliação",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Supabase: pré-avaliação": {
      "main": [
        [
          {
            "node": "Resposta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Cuiaba",
    "saveDataSuccessExecution": "all",
    "callerPolicy": "workflowsFromSameOwner"
  }
}