{
  "name": "Assistente - Pendências",
  "nodes": [
    {
      "id": "00000000-0000-4000-8000-000000000118",
      "name": "A cada 15 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000119",
      "name": "Horário do salão?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "h1",
              "leftValue": "={{ $now.setZone('America/Cuiaba').hour >= 8 && $now.setZone('America/Cuiaba').hour < 20 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000120",
      "name": "Disparar agora (teste)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "parameters": {
        "httpMethod": "GET",
        "path": "assistente-pendencias",
        "responseMode": "lastNode",
        "options": {}
      },
      "webhookId": "6f7a8b9c-0d1e-4f2a-9b3c-4d5e6f7a8b91"
    },
    {
      "id": "00000000-0000-4000-8000-000000000121",
      "name": "Pendências novas",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        440,
        100
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select * from pendencias_gleide where empresa_id = $1\n    and (perguntado_em is null or perguntado_em < now() - interval '3 hours') order by inicio nulls last",
        "options": {
          "queryReplacement": "={{ [ $env.EMPRESA_ID || '00000000-0000-0000-0000-000000000001' ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "vWZfw25p31IboD1j",
          "name": "Salão teste (004)"
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000122",
      "name": "Montar mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        100
      ],
      "parameters": {
        "jsCode": "\nconst ps = $input.all().map((i) => i.json).filter((p) => p.tipo);\nif (!ps.length) return [];\nconst nome = (p) => (p.nome || 'cliente').split(' ').slice(0, 2).join(' ');\nconst hora = (p) => (p.inicio ? new Date(p.inicio).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit', timeZone: 'America/Cuiaba' }) : '');\nconst brl = (v) => Number(v).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL', maximumFractionDigits: 0 });\nconst linha = (p) => {\n  if (p.tipo === 'avaliacao_sem_resultado') return '• Como foi a avaliação da *' + nome(p) + '* (' + hora(p) + ')? Fechou?';\n  if (p.tipo === 'atendimento_sem_status') return '• A *' + nome(p) + '* (' + hora(p) + (p.servico ? ', ' + p.servico.toLowerCase() : '') + ') veio?';\n  return '• A *' + nome(p) + '* ficou de pensar' + (p.valor_orcado ? ' (' + brl(p.valor_orcado) + ')' : '') + '. Alguma novidade?';\n};\nconst texto = 'Oi, Gleide! Pra deixar o CRM em dia:\\n' + ps.map(linha).join('\\n') + '\\n\\nPode responder em áudio, do seu jeito 🙂';\nconst ids = ps.map((p) => p.pendencia_id);\nconst numeros = ($env.ASSISTENTE_NUMEROS || '').split(',').map(s => s.trim()).filter(Boolean);\nreturn numeros.map((tel) => ({ json: { tel, texto, ids,\n  // mesma estrutura que o nó de memória do n8n grava, para o agente saber o que perguntou\n  memoria: JSON.stringify({ type: 'ai', data: { content: texto, additional_kwargs: {}, response_metadata: {}, tool_calls: [], invalid_tool_calls: [] } }) } }));\n"
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000123",
      "name": "Mandar para a Gleide",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_URL }}/message/sendText/{{ $env.EVOLUTION_INSTANCE }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.tel, text: $json.texto }) }}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "id": "00000000-0000-4000-8000-000000000124",
      "name": "Guardar na memória do agente",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        1100,
        100
      ],
      "parameters": {
        "operation": "push",
        "list": "=assistente:{{ $('Montar mensagem').item.json.tel }}",
        "messageData": "={{ $('Montar mensagem').item.json.memoria }}",
        "tail": false
      },
      "credentials": {
        "redis": {
          "id": "bSZHOsNCSsDVJpK7",
          "name": "Redis local"
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000125",
      "name": "Marcar como perguntado",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1320,
        100
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select n8n_assistente_marcar_perguntado($1, $2, $3::uuid[])",
        "options": {
          "queryReplacement": "={{ [ $env.EMPRESA_ID || '00000000-0000-0000-0000-000000000001', $('Montar mensagem').item.json.tel, '{' + $('Montar mensagem').item.json.ids.join(',') + '}' ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "vWZfw25p31IboD1j",
          "name": "Salão teste (004)"
        }
      }
    }
  ],
  "connections": {
