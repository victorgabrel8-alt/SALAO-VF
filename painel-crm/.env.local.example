# Copie este arquivo para .env.local e preencha com os dados do Supabase
# (Project Settings → API). O .env.local NUNCA vai para o GitHub.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Tela Lojas (criar loja nova no motor). Estas ficam SÓ no servidor do painel, nunca no navegador:
# chave de serviço do Supabase (Project Settings → API → service_role)
SUPABASE_SERVICE_KEY=
# Evolution API: endereço público e a chave do servidor (a que cria instância)
EVOLUTION_URL=https://evo.oistudio.com.br
EVOLUTION_API_KEY=
# instância que já existe, de onde o painel copia a senha do webhook
EVOLUTION_INSTANCE_MODELO=karol-manicure
# como a Evolution enxerga o n8n de dentro do servidor
N8N_URL_INTERNA=http://n8n:5678
# quem é da agência (e-mails de login do painel, separados por vírgula)
AGENCIA_EMAILS=
# WhatsApp da agência (55 + DDD + número): a IA de loja nova só responde este número até ser liberada
AGENCIA_WHATSAPP=
